---
layout: null
---
{%- comment -%}
  The Atom feed: jekyll-feed 0.18's template, cut to what this site uses, in
  place of the gem. The gem sorted and dated entries by `date:`, which on a paper
  post is the paper's, so a review written this year went out as published in
  the paper's year, below last year's posts. Entries now go by `posted_at`
  (_plugins/posted_date.rb).
{%- endcomment -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | xml_escape }}">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" hreflang="{{ site.lang | xml_escape }}" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <title type="html">{{ site.title | smartify | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <author>
    <name>{{ site.author | xml_escape }}</name>
  </author>
  {%- assign cdata_end_token = "]]>" %}
  {%- assign cdata_end_token_escaped = "]]]]><![CDATA[>" %}
  {%- comment -%} site.posts is newest first by posted_at, ties by `date:`. {%- endcomment %}
  {%- assign posts = site.posts | where_exp: "post", "post.draft != true" %}
  {%- for post in posts limit: site.feed.posts_limit %}
  {%- assign post_title = post.title | smartify | strip_html | normalize_whitespace | xml_escape %}
  <entry{% if post.lang %} xml:lang="{{ post.lang | xml_escape }}"{% endif %}>
    <title type="html">{{ post_title }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post_title }}" />
    <published>{{ post.posted_at | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.posted_at | date_to_xmlschema }}</updated>
    <id>{{ post.id | absolute_url | xml_escape }}</id>
    {%- unless site.feed.excerpt_only %}
    <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}"><![CDATA[{{ post.content | strip | replace: cdata_end_token, cdata_end_token_escaped }}]]></content>
    {%- endunless %}
    <author>
      <name>{{ site.author | xml_escape }}</name>
    </author>
    {%- for category in post.categories %}
    <category term="{{ category | xml_escape }}" />
    {%- endfor %}
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}" />
    {%- endfor %}
    {%- assign post_summary = post.description | default: post.excerpt %}
    {%- if post_summary and post_summary != empty %}
    <summary type="html"><![CDATA[{{ post_summary | strip_html | normalize_whitespace | replace: cdata_end_token, cdata_end_token_escaped }}]]></summary>
    {%- endif %}
  </entry>
  {%- endfor %}
</feed>
